[Unit]
Description=Restauración PostgreSQL de DietoExpress (%i)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
TimeoutStartSec=0
EnvironmentFile=-/etc/dietoexpress/dietoexpress.env
ExecStartPre=/usr/bin/systemctl stop dietoexpress.service
# El script de /opt valida la copia como joso; helpers root-owned hacen
# pg_dump/pg_restore como postgres mediante sudo restringido.
ExecStart=/usr/bin/runuser -u joso -- /bin/bash /opt/dietoexpress/scripts/dietoexpress-restore-user.sh --restore %i --confirm
# El helper post levanta la aplicación si el restore o el rollback terminaron
# bien. Si ambos fallan (exit 20), mantiene el backend parado y el aviso activo.
ExecStopPost=/usr/local/sbin/dietoexpress-restore-post
