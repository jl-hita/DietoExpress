[Unit]
Description=Backup semanal de PostgreSQL de DietoExpress
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=joso
Group=joso
EnvironmentFile=-/etc/dietoexpress/dietoexpress.env
# El orquestador corre como joso. El helper root-owned gestiona publicación y
# retención del almacén, y ejecuta pg_dump como el rol PostgreSQL postgres.
ExecStart=/opt/dietoexpress/scripts/dietoexpress-backup.sh
UMask=0077
