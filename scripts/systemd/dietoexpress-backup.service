[Unit]
Description=Backup semanal de PostgreSQL de DietoExpress
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=joso
Group=joso
EnvironmentFile=-/etc/dietoexpress/dietoexpress.env
Environment=DIETOEXPRESS_BACKUP_RETENTION=8
# El orquestador se ejecuta como joso e invoca un helper root-owned limitado
# que realiza pg_dump como el rol PostgreSQL postgres.
ExecStart=/opt/dietoexpress/scripts/dietoexpress-backup.sh
UMask=0077
